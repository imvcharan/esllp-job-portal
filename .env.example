PORT=3000
NODE_ENV=development
# Required by the Docker Compose production stack; point DNS to the VPS.
# PUBLIC_APP_HOST=jobs.example.com
# Set to the exact number of trusted reverse proxies in front of the app.
# Keep at 0 when clients connect directly; never trust arbitrary forwarded headers.
TRUST_PROXY_HOPS=0
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=replace-with-a-unique-database-password
POSTGRES_DATABASE=esllp_job_portal
# Set true when your PostgreSQL provider requires TLS.
POSTGRES_SSL=false
# Optional PEM root certificate from the PostgreSQL provider, required by some TLS endpoints.
# POSTGRES_SSL_CA=<paste the complete PEM certificate>
# Alternatively, set DATABASE_URL instead of the POSTGRES_* connection settings.
# DATABASE_URL=postgresql://user:password@host:5432/database
# Redis is optional. When set, public job caches and BullMQ background workers are enabled.
# REDIS_URL=rediss://default:<password>@<host>:<port>
# BULLMQ_WORKER_CONCURRENCY=5
# APP_PROCESS_ROLE=combined
# OpenSearch is optional. Job and recruiter candidate searches fall back to PostgreSQL when absent.
# OPENSEARCH_URL=https://<opensearch-host>:443
# OPENSEARCH_USERNAME=<username>
# OPENSEARCH_PASSWORD=<server-only password>
# OPENSEARCH_TLS_VERIFY=true
# OPENSEARCH_INDEX=esllp-jobs
# OPENSEARCH_CANDIDATE_INDEX=esllp-candidates
# Private candidate file storage. Create this as a private Supabase Storage bucket.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<server-only key; never expose in the frontend>
# SUPABASE_CANDIDATE_BUCKET=candidate-private
# ClamAV daemon is required for resume/photo uploads in production.
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# Development-only escape hatch when deliberately testing uploads without ClamAV.
# It is ignored unless NODE_ENV=development; never enable in production.
# ALLOW_UNSCANNED_LOCAL_FILES=true
# Account verification, password recovery, application, and job-alert emails.
PUBLIC_APP_URL=http://localhost:3000
# Public origin used for canonical SEO URLs.
# PUBLIC_APP_URL=https://esllp.in
# Google Calendar/Meet integration for employer interview scheduling.
# GOOGLE_CALENDAR_REFRESH_TOKEN=<owner-provided refresh token>
# GOOGLE_CALENDAR_CLIENT_ID=<Google OAuth client ID>
# GOOGLE_CALENDAR_CLIENT_SECRET=<server-only Google OAuth client secret>
# Account deletion retention period before scheduled erasure.
# ACCOUNT_DELETION_RETENTION_DAYS=30
# Generate a random secret of at least 32 characters; required to access /api/health/metrics.
# METRICS_BEARER_TOKEN=<server-only monitoring scrape token>
# Backup scripts require GPG, rclone, and an offsite remote configured by the operator.
# BACKUP_GPG_RECIPIENT=<GPG public-key recipient used to encrypt PostgreSQL dumps>
# BACKUP_RCLONE_REMOTE=<rclone remote name/path for encrypted offsite database backups>
# BACKUP_RETENTION_DAYS=35
# PRIVATE_OBJECTS_SOURCE=<rclone source remote configured for the private Supabase bucket>
# PRIVATE_OBJECTS_BACKUP_REMOTE=<rclone crypt remote configured for offsite object backups>
# PRIVATE_OBJECTS_RETENTION_DAYS=35
# Operational recovery targets are initial placeholders; set them from the deployment SLA.
# BACKUP_RPO_HOURS=24
# BACKUP_RTO_HOURS=8
# Google Identity Services client ID for candidate sign-in.
# GOOGLE_OAUTH_CLIENT_ID=<Google OAuth web client ID>
# In Google Cloud, add each deployed website origin to this OAuth client's
# Authorized JavaScript origins (no path or trailing slash):
# https://esllp.in
# https://www.esllp.in
# Google reCAPTCHA v2 checkbox; required for public account actions in production.
# RECAPTCHA_SITE_KEY=<Google reCAPTCHA site key>
# RECAPTCHA_SECRET_KEY=<server-only Google reCAPTCHA secret>
# RECAPTCHA_ALLOWED_HOSTNAMES=example.com,www.example.com
# Add each deployed hostname to the reCAPTCHA key's allowed domains too.
# RECAPTCHA_ALLOWED_HOSTNAMES=esllp.in,www.esllp.in
# Required for superadmin TOTP MFA secret encryption; keep stable across deploys.
# MFA_CONFIG_ENCRYPTION_KEY=<stable random 32+ character server-only key>
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=<server-only SMTP password>
# SMTP_FROM=esllp Jobs <no-reply@your-domain.example>
# SMS phone verification (Twilio; credentials are server-only).
# TWILIO_ACCOUNT_SID=<Twilio account SID>
# TWILIO_AUTH_TOKEN=<Twilio auth token>
# TWILIO_FROM_NUMBER=+1XXXXXXXXXX
# TWILIO_CONFIG_ENCRYPTION_KEY=<stable random 32+ character key for dashboard-managed Twilio auth tokens>
# Optional WhatsApp sender/template fallback; WhatsApp remains disabled until enabled in the admin settings.
# TWILIO_WHATSAPP_FROM=whatsapp:+1XXXXXXXXXX
# TWILIO_WHATSAPP_TEMPLATE_SID=HX<32 hexadecimal characters>
# Employer SaaS billing: configure monthly INR plans in Razorpay, then copy each plan ID.
# The displayed amounts are informational; Razorpay's configured plan determines billing.
# RAZORPAY_KEY_ID=<server-side API key ID; the public checkout key is returned by the API>
# RAZORPAY_KEY_SECRET=<server-only API secret>
# RAZORPAY_WEBHOOK_SECRET=<server-only webhook signing secret>
# RAZORPAY_CONFIG_ENCRYPTION_KEY=<stable random 32+ character key; encrypts dashboard-managed Razorpay secrets at rest>
# RAZORPAY_PLAN_STARTER=<Razorpay monthly INR plan ID>
# RAZORPAY_PLAN_GROWTH=<Razorpay monthly INR plan ID>
# RAZORPAY_PLAN_BUSINESS=<Razorpay monthly INR plan ID>
# RAZORPAY_PLAN_ENTERPRISE=<Razorpay monthly INR plan ID>
# Optional display amounts; keep these aligned with the Razorpay plan amounts.
# EMPLOYER_STARTER_PRICE_INR=
# EMPLOYER_GROWTH_PRICE_INR=
# EMPLOYER_BUSINESS_PRICE_INR=
# EMPLOYER_ENTERPRISE_PRICE_INR=
# Generate a unique 32+ character secret. Never use the example value in production.
JWT_ACCESS_SECRET=replace-with-a-unique-random-secret-at-least-32-characters-long
# Set only when running `npm run bootstrap:superadmin`.
SUPERADMIN_NAME=Portal Administrator
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=replace-with-a-unique-password-at-least-8-characters
# Optional path to a locally hosted MaxMind GeoLite2-City.mmdb database.
# The database file is licensed separately and must not be committed to Git.
# GEOIP_DATABASE_PATH=C:\geoip\GeoLite2-City.mmdb
