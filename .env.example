PORT=3000
NODE_ENV=development
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=replace-with-a-unique-database-password
POSTGRES_DATABASE=esllp_job_portal
# Set true when your PostgreSQL provider requires TLS.
POSTGRES_SSL=false
# Optional PEM root certificate from the PostgreSQL provider, required by some TLS endpoints.
# POSTGRES_SSL_CA=<paste the complete PEM certificate>
# Alternatively, set DATABASE_URL instead of the POSTGRES_* connection settings.
# DATABASE_URL=postgresql://user:password@host:5432/database
# Private candidate file storage. Create this as a private Supabase Storage bucket.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<server-only key; never expose in the frontend>
# SUPABASE_CANDIDATE_BUCKET=candidate-private
# Account verification, password recovery, application, and job-alert emails.
# PUBLIC_APP_URL=https://your-production-domain.example
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=<server-only SMTP password>
# SMTP_FROM=esllp Jobs <no-reply@your-domain.example>
# Employer SaaS billing: configure monthly INR plans in Razorpay, then copy each plan ID.
# The displayed amounts are informational; Razorpay's configured plan determines billing.
# RAZORPAY_KEY_ID=<server-side API key ID; the public checkout key is returned by the API>
# RAZORPAY_KEY_SECRET=<server-only API secret>
# RAZORPAY_WEBHOOK_SECRET=<server-only webhook signing secret>
# RAZORPAY_PLAN_STARTER=<Razorpay monthly INR plan ID>
# RAZORPAY_PLAN_GROWTH=<Razorpay monthly INR plan ID>
# Optional display amounts; keep these aligned with the Razorpay plan amounts.
# EMPLOYER_STARTER_PRICE_INR=
# EMPLOYER_GROWTH_PRICE_INR=
# Generate a unique 32+ character secret. Never use the example value in production.
JWT_ACCESS_SECRET=replace-with-a-unique-random-secret-at-least-32-characters-long
# Set only when running `npm run bootstrap:superadmin`.
SUPERADMIN_NAME=Portal Administrator
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=replace-with-a-unique-password-at-least-8-characters
