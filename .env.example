PORT=3000
NODE_ENV=development
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=replace-with-a-unique-database-password
POSTGRES_DATABASE=esllp_job_portal
# Set true when your PostgreSQL provider requires TLS.
POSTGRES_SSL=false
# Alternatively, set DATABASE_URL instead of the POSTGRES_* connection settings.
# DATABASE_URL=postgresql://user:password@host:5432/database
# Generate a unique 32+ character secret. Never use the example value in production.
JWT_ACCESS_SECRET=replace-with-a-unique-random-secret-at-least-32-characters-long
# Set only when running `npm run bootstrap:superadmin`.
SUPERADMIN_NAME=Portal Administrator
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=replace-with-a-long-unique-password
